# NOTE: in systemd, "unit" is service, timer, etc.  That's why it takes `--unit=...` but we mainly use "service".

if __name__ == '__main__':
    try: import kpa.dev_utils
    except ImportError: pass
    else: kpa.dev_utils.run(__file__, make_cache=False, run_rarely=True)


from typing import Optional,List,TypeVar,Iterator
import subprocess, os, random, re, shutil, json, sys, argparse, time
from pathlib import Path

os.environ['TZ'] = '/usr/share/zoneinfo/America/Detroit'  # Tells `journalctl` to print dates in this timezone.  Maybe move to `.bashrc`?

def print_and_run(argv:List[str], timeout:Optional[int] = None, check:bool=True) -> None:
    print(argv, flush=True)
    if timeout:
        # Normally you can do subprocess.run(argv, timeout=5), but `sudo` ruins that.
        p = subprocess.Popen(argv)  # Executes in background
        time.sleep(timeout)
        assert p.pid > 1
        subprocess.run(['sudo', '/bin/kill', '-9', str(p.pid)])
        p.wait()  # Clean up zombie
        print(f'\n--> {timeout} second timeout')
    else:
        subprocess.run(argv, check=check)  # Executes in foreground

def get_dotksys_path() -> Optional[Path]:
    """Return the path to .ksys/ in an ancestor directory, like how .git/ works."""
    path = Path().absolute()
    while path:
        if (dotksys_path := (path / '.ksys')).is_dir():
            return dotksys_path
        if path == path.parent: break
        path = path.parent
    return None

def get_template_instances(template_name: str) -> List[str]:
    """Convert a template service (eg 'openvpn-server@') to actual service instances (eg 'openvpn-server@east')."""
    ## Remember: Systemd has ~10 types of units, including .service, .timer, .target, etc.  We're dealing with services.
    ## I get confused bc `systemctl status foo` is shorthand for `... foo.service` bc services are the best unit.
    try:
        out = subprocess.check_output(['systemctl', 'list-units', '--all', '--output=json', f'{template_name}*'])
        units = [u['unit'].removesuffix('.service') for u in json.loads(out) if u.get('unit')]
        return [u for u in units if u != template_name and u.startswith(template_name)]
    except Exception:
        return []

def get_service_name() -> str:
    """Guess the `<name>.service` to use. First look for `.ksys/<name>.service` and then check if we're in `/srv/<name>/` or `/etc/<name>/`."""
    if (dotksys_path := get_dotksys_path()):
        raw_service_names = [path.name.split('%')[-1].removesuffix('.service') for path in dotksys_path.glob('*.service')]
        service_names = []
        for name in raw_service_names:
            if name.endswith('@'):
                instances = get_template_instances(name)
                if not instances:
                    raise Exception(f"Found template unit '{name}.service' in .ksys/, but couldn't detect any running or enabled instance (e.g. {name}foo).")
                service_names.extend(instances)
            else:
                service_names.append(name)
        if service_names:
            if len(service_names) > 1: raise Exception(f'Use `-u` to choose one of: {" ".join(service_names)}')
            return service_names[0]
    cwd = Path().absolute()
    if cwd.parts[:2] == ('/', 'srv') and len(cwd.parts) >= 3:
        return f"kpa-{cwd.parts[2]}"
    if cwd.parts[:2] == ('/', 'etc') and len(cwd.parts) >= 3:
        return cwd.parts[2].split('.')[0] # handle "logrotate.d", "cron.daily", "rsyslog.conf", etc
    if dotksys_path:
        raise Exception("Couldn't detect service name: `.ksys/` contains no `.service` files and you're not in `/srv/*/` or `/etc/*/`.")
    raise Exception("Couldn't detect service name: no ancestor directory contains `.ksys/` and you're not in `/srv/*/` or `/etc/*/`.")

def log(args:argparse.Namespace) -> None:
    """Show logs for a service."""
    service_name = args.unit or get_service_name()
    if args and args.all:
        cmd = ["sudo", "journalctl", "-u", service_name, '--no-hostname']
    elif args and args.follow:
        cmd = ["sudo", "journalctl", "-u", service_name, '--follow', '--no-hostname']
        print('--- Ctrl-C quits ---', flush=True)
    else:
        last_run_id = subprocess.check_output(['systemctl','show','--value','-p','InvocationID',service_name]).decode().strip()
        cmd = ["sudo", "journalctl", f"_SYSTEMD_INVOCATION_ID={last_run_id}", '--no-hostname']
    try: print_and_run(cmd)
    except KeyboardInterrupt: print()

def stat(args:argparse.Namespace) -> None:
    """Show the status and recent logs for a service."""
    service_name = str((args and args.unit) or get_service_name())
    # TODO: Allow retcode=3 for oneshot/timer services
    cmd = ["sudo", "systemctl", "--no-pager", "status", "-n0", service_name]
    print_and_run(cmd); print()
    cmd = ["sudo", "journalctl", "--no-pager", "-n20", "-u", service_name, '--no-hostname']
    print_and_run(cmd)

def restart(args:argparse.Namespace) -> None:
    """Restart a service, and then show some logs to let you verify that it's working."""
    service_name = args.unit or get_service_name()
    try:
        out = subprocess.check_output(['sudo', 'journalctl', '-u', service_name, '--quiet', '--output-fields=__CURSOR', '-n1', '--output=json'])
        cursor = json.loads(out).get('__CURSOR')
    except Exception:
        cursor = None
    # Restart
    cmd = ["sudo", "systemctl", "restart", service_name]
    print_and_run(cmd); print()

    # Note: `systemctl restart` waits for a type=oneshot service to exit.
    service_type = subprocess.check_output(['systemctl', 'show', '--value', '--property=Type', service_name]).decode().strip()
    if service_type == 'oneshot':
        if cursor:
            cmd = ['sudo', 'journalctl', '-u', service_name, '--no-pager', '--no-hostname', '--after-cursor', cursor]
        else:
            last_run_id = subprocess.check_output(['systemctl','show','--value','--property=InvocationID',service_name]).decode().strip()
            cmd = ["sudo", "journalctl", f"_SYSTEMD_INVOCATION_ID={last_run_id}", '--no-pager', '--no-hostname']
        try: print_and_run(cmd)
        except KeyboardInterrupt: pass
    else:
        if cursor:
            cmd = ['sudo', 'journalctl', '-u', service_name, '--no-pager', '--no-hostname', '--follow', '--after-cursor', cursor]
        else:
            # This misses messages that are printed too quick after the restart
            cmd = ["sudo", "journalctl", '-u', service_name, '--no-pager', '--no-hostname', '--follow', '-n1']
        print('--- Ctrl-C quits ---', flush=True)
        try: print_and_run(cmd, timeout=args.timeout) if args.timeout else print_and_run(cmd)
        except KeyboardInterrupt: pass
    print()

    # Show the current state of the service
    subprocess.run(['sudo', 'systemctl', 'is-failed', service_name])

def stop(args:argparse.Namespace) -> None:
    """Stop a service"""
    service_name = args.unit or get_service_name()
    cmd = ["sudo", "systemctl", "stop", service_name]
    print_and_run(cmd); print()


def watch(args:argparse.Namespace) -> None:
    """Watch a path (file or directory) for changes, and restart when it changes"""
    # TODO: maybe hide this output and just show `ksys log --follow`?
    import watchgod
    print('--> Watching: ', args.path)
    service_name = args.unit or get_service_name()
    for changes in watchgod.watch(args.path):
        print('--> Restarting!')
        subprocess.run(['sudo', 'systemctl', 'restart', service_name])

def venv(args:argparse.Namespace) -> None:
    """Make ./venv/ and gitignore it."""
    # LATER: Require uv, use .venv/
    if Path('venv').exists():
        if args.force: shutil.rmtree('venv'); print('rm -rf venv')
        else: raise Exception('`./venv/` already exists.  Use -f to overwrite.')
    USE_UV = bool(shutil.which('uv'))
    if USE_UV:
        print_and_run(['uv', 'venv', 'venv'])  # uv expects ./.venv/, but we can force ./venv/
        install_cmd = ['uv','pip','install','--python=venv/bin/python']
    else:
        print('=> WARNING: YOU ARE USING PIP INSTEAD OF UV!')
        print_and_run([args.python, '-m', 'venv', 'venv'])
        install_cmd = ['./venv/bin/pip3']
        print_and_run(install_cmd+['install', '-U', 'wheel'])
        print_and_run(install_cmd+['install', '-U', 'pip', 'setuptools'])

    req_paths = [Path(p) for p in args.requirement]
    if Path('requirements.txt').exists(): req_paths.append(Path('requirements.txt'))
    for req_path in req_paths: print_and_run(install_cmd+['-r', str(req_path)])

    epkg_paths = [Path(p) for p in args.editable]
    for epkg_path in epkg_paths: print_and_run(install_cmd+['-e', str(epkg_path)])

    if Path('.git').is_dir():
        gitignore_path = Path('.gitignore')
        if not gitignore_path.is_file():
            gitignore_path.write_text('venv\n')
        elif 'venv' not in gitignore_path.read_text():
            gitignore_path.write_text(gitignore_path.read_text().rstrip() + '\nvenv\n')

systemd_service_template = '''\
[Unit]
Description={name}
After=network-online.target
OnFailure=kpa-failure-telegram@%i.service

[Service]
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
# RuntimeDirectory is auto-created in /run/ tmpfs
RuntimeDirectory={name}
Environment=HOME=/run/{name}
WorkingDirectory={dir}
ExecStart={exec}
'''
systemd_daemon_template = systemd_service_template + '''\

[Install]
WantedBy=multi-user.target
'''
systemd_scheduled_template = systemd_service_template + '''\
Type=oneshot
Nice=10
'''
systemd_timer_template = '''\
[Unit]
Description={name}

[Timer]
OnCalendar=*-*-* 00,12:00:00
RandomizedDelaySec=1m
Persistent=true

[Install]
WantedBy=timers.target
'''
nginx_template = '''\
server {
  server_name {hostname};
  listen 80;
  location / {
    include proxy_params;
    proxy_pass http://localhost:{port};
  }
}
'''
nginx_template = re.subn(r'(\s})', r'\1}', re.subn(r'({\s)', r'{\1', nginx_template)[0])[0]  # escape `{ ` and ` }`

nginx_ssl_template = '''\
server {
  server_name {hostname};
  listen 443 ssl;
  ssl_certificate /etc/letsencrypt/live/wildcard/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/wildcard/privkey.pem;
  location / {
    include proxy_params;
    proxy_pass http://localhost:{port};
  }
}
server {
  server_name {hostname};
  listen 80;
  return 301 https://$host$request_uri;
}
'''
nginx_ssl_template = re.subn(r'(\s})', r'\1}', re.subn(r'({\s)', r'{\1', nginx_ssl_template)[0])[0]

def conf_create(args:argparse.Namespace) -> None:
    """Create ./.ksys/ and put config in it."""
    name = str(args.name) if args.name else get_service_name()
    dotksys_path = Path('.ksys')
    dotksys_path.mkdir(exist_ok=True)
    directory = str(Path().absolute()) + '/'  # aesthetic
    if args.timer:
        filename = f'/etc/systemd/system/{name}.service'.replace('/', '%')
        (dotksys_path / filename).write_text(systemd_scheduled_template.format(
            name=name,
            dir=directory,
            exec=f'{directory}/run.py',
        ))
        filename = f'/etc/systemd/system/{name}.timer'.replace('/', '%')
        (dotksys_path / filename).write_text(systemd_timer_template.format(name=name))
    elif args.nginx_hostname:
        port = 8000 + random.randrange(1000)
        filename = f'/etc/systemd/system/{name}.service'.replace('/', '%')
        (dotksys_path / filename).write_text(systemd_daemon_template.format(
            name=name,
            dir=directory,
            exec=f'{directory}/serve.py --port={port}',
        ))
        hostname = args.nginx_hostname if len(args.nginx_hostname)>1 else (f'{name[4:]}.petervh.com' if name.startswith('kpa-') else f'{name}.petervh.com')
        filename = f'/etc/nginx/sites-available/{hostname}'.replace('/', '%')
        tpl = nginx_ssl_template if args.https else nginx_template
        (dotksys_path / filename).write_text(tpl.format(hostname=hostname, port=port))
    else:
        filename = f'/etc/systemd/system/{name}.service'.replace('/', '%')
        (dotksys_path / filename).write_text(systemd_daemon_template.format(
            name=name,
            dir=directory,
            exec=f'{directory}/run.py',
        ))
    print('Now populate Exec= in .ksys/*.service and run `ksys conf diff` and `ksys conf install`')

def conf_install(args:argparse.Namespace) -> None:
    """Copy config from .ksys/ to /etc/ and restart services as appropriate."""
    if not (dotksys_path := get_dotksys_path()): raise Exception('No directory ./.ksys')
    for path in dotksys_path.iterdir():
        if path.name.endswith('~') or '#' in path.name: continue  # temp file
        dest_path = Path(path.name.replace('%', '/'))
        print_and_run(['sudo', 'cp', '-f', str(path), str(dest_path)])
        if path.name.startswith('%etc%systemd') and path.suffix == '.timer':
            print_and_run(['sudo', 'systemctl', 'enable', '--now', dest_path.name])  # Makes it auto-start on boot, and also starts it right now
        elif path.name.startswith('%etc%systemd') and path.suffix == '.service':
            if 'WantedBy' in path.read_text():
                print_and_run(['sudo', 'systemctl', 'enable', '--now', dest_path.name])
        elif path.name.startswith('%etc%nginx'):
            if path.name.startswith('%etc%nginx%sites-available%'):
                print_and_run(['sudo', 'ln', '-sf', str(dest_path), '/etc/nginx/sites-enabled'])
            print_and_run(['sudo', 'nginx', '-t'])
            print_and_run(['sudo', 'systemctl', 'restart', 'nginx'])
            print('You might need to run `certbot`')
        print_and_run(['sudo', 'systemctl', 'daemon-reload'])
    if args.restart:
        restart(argparse.Namespace(unit=None,timeout=None))

def conf_import(args:argparse.Namespace) -> None:
    """Copy config into `.ksys/`."""
    dotksys_path = get_dotksys_path() or Path('.ksys')
    dotksys_path.mkdir(exist_ok=True)
    for path in args.paths:
        dest_path = dotksys_path / str(path).replace('/', '%')
        print(f'Copying {path} -> {dest_path}')
        shutil.copy(path, dest_path)

def conf(args:argparse.Namespace) -> None:
    """Print an overview of .ksys/* configs, their sync status, and explain subcommands."""
    if not (dotksys_path := get_dotksys_path()):
        print("No .ksys/ directory found. Use `ksys conf-create` to initialize one.")
        return

    print("Config files in .ksys/:")
    files = sorted([p for p in dotksys_path.iterdir() if not p.name.endswith('~') and '#' not in p.name])
    if not files:
        print("  (empty)")
    for path in files:
        dest_path = Path(path.name.replace('%', '/'))
        if not dest_path.exists():
            status = "missing on system"
        elif dest_path.read_text() == path.read_text():
            status = "identical"
        else:
            status = "modified"
        print(f"  {dest_path} [{status}]")

    print("\nSubcommands:")
    print("  ksys conf diff      Show diff between .ksys/ and /etc/")
    print("  ksys conf install   Install .ksys/ files into /etc/ and reload/restart")
    print("  ksys conf create    Generate boilerplate config in .ksys/")
    print("  ksys conf import    Copy files from system into .ksys/")

def conf_diff(args:argparse.Namespace) -> None:
    """Diff config in `.ksys/` against `/etc/`."""
    if not (dotksys_path := get_dotksys_path()): raise Exception('No directory ./.ksys')
    num_cols = shutil.get_terminal_size((80, 20)).columns
    for path in dotksys_path.iterdir():
        if path.name.endswith('~') or '#' in path.name: continue  # temp file
        dest_path = Path(path.name.replace('%', '/'))
        if not dest_path.exists():
            print(f"===== {path} ===== {dest_path} [[doesn't exist]]")
        elif dest_path.read_text() == path.read_text():
            print(f'===== {path} ===== {dest_path} == [[identical]]')
        else:
            print(f'===== {path} ===== {dest_path}')
            subprocess.run(['diff', '-dyb', f'--width={num_cols}', str(path), str(dest_path)])
        print()


def skel_gitlab(args:argparse.Namespace) -> None:
    """Initialize a skeleton of a local git repo and a remote gitlab repo."""
    if not (dotksys_path := get_dotksys_path()): raise Exception('No directory ./.ksys')
    if dotksys_path.parent != Path().absolute(): raise Exception(f'Please `cd ..` first to project root containing {dotksys_path}')
    name = get_service_name()
    print('=> Run `git init`')
    print('=> Run `git stage .ksys *.py *.txt`')
    print('=> Run `git commit -m "init"`')
    print('=> Open https://gitlab.com/projects/new#blank_project')
    print(f'    Use name = {name}')
    print('    Uncheck "Add README"')
    print('    Hit <Create!>')
    print(f'=> Run `git remote add origin git@gitlab.com:pjvandehaar/{name}.git`')
    print('=> Run `git push`')



if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='Manage systemd services and connecting them to nginx via .ksys/')
    commands = parser.add_subparsers(dest='command')

    log_parser = commands.add_parser('log', aliases=['l'], help='See logs')
    log_parser.add_argument('-u', '--unit', type=str, default=None, help='What systemd unit')
    log_parser.add_argument('-a', '--all', action='store_true', help='Show all logs rather than only the latest run')
    log_parser.add_argument('--follow', action='store_true', help='Follow the end (Ctrl-C to stop)')
    log_parser.set_defaults(func=log)

    stat_parser = commands.add_parser('stat', aliases=['s', 'status'], help='See status')
    stat_parser.add_argument('-u', '--unit', type=str, default=None, help='What systemd unit')
    stat_parser.set_defaults(func=stat)

    restart_parser = commands.add_parser('restart', aliases=['r'], help='Restart')
    restart_parser.add_argument('-u', '--unit', type=str, default=None, help='What systemd unit')
    restart_parser.add_argument('-t', '--timeout', type=int, default=None, help='How long to watch logs.  Has no effect on oneshots.')
    restart_parser.set_defaults(func=restart)

    stop_parser = commands.add_parser('stop', help='Stop')
    stop_parser.add_argument('-u', '--unit', type=str, default=None, help='What systemd unit')
    stop_parser.set_defaults(func=stop)

    watch_parser = commands.add_parser('watch', aliases=['w'], help="Reload when a file or directory changes")
    watch_parser.add_argument('-u', '--unit', type=str, default=None, help='What systemd unit')
    watch_parser.add_argument('-t', '--timeout', type=int, default=2, help='How long to follow logs.  Has no effect on oneshots.')
    watch_parser.add_argument('path', type=str, help='What path (file or directory) to watch')
    watch_parser.set_defaults(func=watch)

    venv_parser = commands.add_parser('venv', help='Create a virtualenv')
    venv_parser.add_argument('-f', '--force', action='store_true', help='Overwrite any existing `./venv/`')
    venv_parser.add_argument('-r', '--requirement', type=str, default=[], action='append', help='an extra requirements.txt file to install from using `pip install -r` (./requirements.txt is always installed from if it exists)')
    venv_parser.add_argument('-e', '--editable', type=str, default=[], action='append', help='an editable package to install using `pip install -e`')
    venv_parser.add_argument('-p', '--python', type=str, default='python3', help='the python executable to use')
    venv_parser.set_defaults(func=venv)

    conf_parser = commands.add_parser('conf', help='Show overview of .ksys/ configs and sync status')
    conf_parser.set_defaults(func=conf)
    conf_sub = conf_parser.add_subparsers(dest='conf_command')

    for p in [conf_sub.add_parser('create', help='Create .ksys/ and generate boilerplate configs'),
              commands.add_parser('conf-create', help='Create .ksys/ and generate boilerplate configs')]:
        p.add_argument('--name', type=str, default=None, help='What name to use (defaults to kpa-{dirname})')
        p.add_argument('--timer', action='store_true', help='Create a timer rather than a daemon')
        p.add_argument('--nginx-hostname', type=str, default=None, help='Create nginx config for a daemon listening on this hostname (or `.` for default)')
        p.add_argument('--https', action='store_true', help='Configure HTTPS (port 443) using wildcard cert and redirect HTTP')
        p.set_defaults(func=conf_create)

    for p in [conf_sub.add_parser('install', help='Copy config from .ksys/ to /etc/ and reload/restart'),
              commands.add_parser('conf-install', help='Copy config from .ksys/ to /etc/ and reload/restart')]:
        p.add_argument('--restart', '-r', action='store_true', help='Also restart the unit, like ksys r')
        p.set_defaults(func=conf_install)

    for p in [conf_sub.add_parser('import', help='Copy existing system config into .ksys/'),
              commands.add_parser('conf-import', help='Copy existing system config into .ksys/')]:
        p.add_argument('paths', type=str, nargs='+')
        p.set_defaults(func=conf_import)

    for p in [conf_sub.add_parser('diff', help='Diff config in .ksys/ against /etc/'),
              commands.add_parser('conf-diff', help='Diff config in .ksys/ against /etc/')]:
        p.set_defaults(func=conf_diff)

    skel_gitlab_parser = commands.add_parser('skel-gitlab', help='Print steps to initialize local and GitLab repo')
    skel_gitlab_parser.set_defaults(func=skel_gitlab)

    args = parser.parse_args() if sys.argv[1:] else parser.parse_args(['stat'])
    args.func(args)
